<UserControl x:Class="NIM.YDControls.MainChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NIM.YDControls"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="800"
             Background="#FF282828">

    <UserControl.Resources>
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF373100"/>
            <Setter Property="Foreground" Value="#FFFAE306"/>
            <Setter Property="BorderBrush" Value="#FFFAE306"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFAE306"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Current"
                       Foreground="#FFFAE306" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Real-time Token Usage"
                       Foreground="#FF979494" FontSize="12" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,12"
                Background="#FF282828" CornerRadius="10"
                BorderBrush="#FF282828" BorderThickness="1">
            <local:RealtimeLineChart
                x:Name="TokenChart"
                Title="Token Usage"
                Unit="Tokens"
                MinValue="0" MaxValue="0"
                MaxPoints="80"
                LineColor="#5B8EFF"
                BackgroundColor="#FF282828"
                GridColor="#FF484747"
                LabelColor="#FFA5A5A5"
                LineThickness="2"
                GridRows="4" GridColumns="8"
                ShowFill="True"
                ShowDot="True"
                RefreshInterval="300"
                />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Total"
                 Foreground="#FFFAE306" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Total Token Usage"
                 Foreground="#FF979494" FontSize="12"
                 Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,0,0,12"
        Background="#FF282828" CornerRadius="10"
        BorderBrush="#FF282828" BorderThickness="1">
            <local:RealtimeLineChart
        x:Name="TotalTokenChart"
        Title="Total Token Usage"
        Unit="Tokens"
        MinValue="0" MaxValue="0"
        MaxPoints="80"
        LineColor="#FFD58811"
        BackgroundColor="#FF282828"
        GridColor="#FF484747"
        LabelColor="#FFA5A5A5"
        LineThickness="2"
        GridRows="4" GridColumns="8"
        ShowFill="True"
        ShowDot="True"
        RefreshInterval="300"
        />
        </Border>

        <Grid Grid.Row="4">
            <!--<StackPanel Orientation="Horizontal">
                <Label Foreground="White" FontSize="21">
                    ModName:
                </Label>
                <Label Foreground="White" FontSize="21" Margin="5 0 0 0" Name="Tokens">
                    Current:
                </Label>
            </StackPanel>-->
        </Grid>


        <!-- Controls -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnPause" Content="⏸  PAUSE"  Style="{StaticResource CustomButtonStyle}"
                    Click="BtnPause_Click"
                    Width="110" Height="34"
                    BorderThickness="1"
                    FontSize="12"
                    Cursor="Hand" Margin="0,0,12,0"/>
            <Button x:Name="BtnClear" Content="✕  CLEAR"  Style="{StaticResource CustomButtonStyle}"
                    Click="BtnClear_Click"
                    Width="110" Height="34"
                    BorderThickness="1"
                    FontSize="12" 
                    Cursor="Hand"/>
            <Grid Width="25" Height="25" Background="#FFD58811" Visibility="Hidden">
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
