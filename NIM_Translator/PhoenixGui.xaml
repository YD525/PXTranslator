                                                    </StackPanel>

                                                    <StackPanel Margin="0 5 0 0">
                                                        <TextBox Style="{StaticResource SettingHintR}" Margin="0" Text="Whether to enforce absolute purity of 'Link Buckets' (Type == 1 — buckets holding units that have a real, established link relationship in the ESP file). Enabled (true): once built, Link Buckets can never have additional content appended or merged into them (orphan-unit backfill, similarity-bucket merging, etc. all skip Link Buckets). Every unit inside a Link Bucket is guaranteed to come from the same genuine ESP link chain — nothing unrelated gets mixed in. This matters because these buckets are sent together as shared context; letting unrelated content leak in can confuse the AI about which entries are actually related, leading to wrong context inference or inconsistent translations. Disabled (false, default): Link Buckets may still receive extra content appended to them whenever there's remaining capacity, which improves packing efficiency and reduces the total bucket count, at the cost of allowing unrelated entries into an otherwise link-only bucket."/>
                                                    </StackPanel>

                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource SettingCard}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Ellipse Width="7" Height="7" Fill="{StaticResource SettingAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="DataBase" Style="{StaticResource SettingSectionTitle}"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox Name="GlobalSearch" Click="EnableGlobalSearch_Click" Style="{StaticResource SettingToggle}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                        <TextBlock Style="{StaticResource SettingHint}" Margin="0" VerticalAlignment="Center" Text="Global Data Retrieval."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0 5 0 0">
                                                        <TextBox Style="{StaticResource SettingHintR}" Margin="0" Text="Allow retrieval of the entire database using source text. This option may speed up translation but could reduce accuracy, as the same text may have different meanings across mods."/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0 13 0 0">
                                                        <CheckBox Name="AutoUpdateStringsFileToDatabase" Click="AutoUpdateStringsFileToDatabase_Click" Style="{StaticResource SettingToggle}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                                        <TextBlock Style="{StaticResource SettingHint}" Margin="0" VerticalAlignment="Center" Text="Automatic Training Database."/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0 5 0 0">
                                                        <TextBox Style="{StaticResource SettingHintR}" Margin="0" Text="When enabled, matched entries from strings files will be automatically imported into the Advanced Dictionary, allowing strings file records to be efficiently reused. Entries from a single strings file can be shared across multiple mods, maximizing their usefulness. This is an experimental feature designed to improve the efficiency of strings file utilization."/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource SettingCard}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Ellipse Width="7" Height="7" Fill="{StaticResource SettingAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Placeholders" Style="{StaticResource SettingSectionTitle}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="P-Placeholders:" Style="{StaticResource SettingFieldLabel}" Margin="0,0,8,0"/>
                                                        <Border Style="{StaticResource SettingInputBorder}" Width="320">
                                                            <TextBox Name="P_Placeholders" TextChanged="P_Placeholders_TextChanged" Style="{StaticResource SettingTextBox}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBox Style="{StaticResource SettingHintR}" Text="The Preprocessor is used to protect keywords from translation by both AI and traditional platforms. It uses regular expressions to determine which words can be protected. Please separate multiple regular expressions with &quot;,&quot;. (You need to ensure the preprocessor node is enabled for it to function.)"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource SettingCard}" Margin="0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Ellipse Width="7" Height="7" Fill="{StaticResource SettingAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Multithreading" Style="{StaticResource SettingSectionTitle}"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Throttling Ratio:" Style="{StaticResource SettingFieldLabel}" Margin="0,0,8,0"/>
                                                        <Border Style="{StaticResource SettingInputBorder}" Width="100">
                                                            <TextBox Name="SThrottlingRatio" TextChanged="SThrottlingRatio_TextChanged" Style="{StaticResource SettingTextBox}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBox Style="{StaticResource SettingHintR}" Text="When the number of threads reaches the specified percentage of the maximum number of threads (default 0.7 = 70%), the current limiting policy is triggered."/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                        <TextBlock Text="Rotation Delay:" Style="{StaticResource SettingFieldLabel}" Margin="0,0,8,0"/>
                                                        <Border Style="{StaticResource SettingInputBorder}" Width="100">
                                                            <TextBox Name="SRotationDelay" TextChanged="SRotationDelay_TextChanged" Style="{StaticResource SettingTextBox}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBox Style="{StaticResource SettingHintR}" Text="Sleep time after triggering the throttling policy (default 200 milliseconds). (If you don't understand, don't mess around.)"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                        <TextBlock Text="Max Thread Limit:" Style="{StaticResource SettingFieldLabel}" Margin="0,0,8,0"/>
                                                        <Border Style="{StaticResource SettingInputBorder}" Width="100">
                                                            <TextBox Name="SMaxThread" TextChanged="SMaxThread_TextChanged" Style="{StaticResource SettingTextBox}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBox Style="{StaticResource SettingHintR}" Text="Set the maximum number of threads allowed to be created during batch translation.(Do not change this setting unless you fully understand it; an overly high thread count is dangerous. If the target API has no rate limits and responds fast, setting 1000 threads could fire 1000 requests in just one second. If you're using a paid cloud AI service, your balance will be drained instantly on mods with large entry counts!)"/>
                                                </StackPanel>
                                            </Border>


                                            <Border Style="{StaticResource SettingCard}" Margin="0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Ellipse Width="7" Height="7" Fill="{StaticResource SettingAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Language Detection" Style="{StaticResource SettingSectionTitle}"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                        <CheckBox Name="SEnableLanguageDetect" Click="SEnableLanguageDetect_Click" Style="{StaticResource SettingToggle}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                                        <TextBlock Style="{StaticResource SettingHint}" Margin="0" VerticalAlignment="Center" Text="Enable Auto Detection."/>
                                                    </StackPanel>

                                                    <TextBox Style="{StaticResource SettingHintR}" Text="When the language selection is set to Auto, attempt to detect the target language automatically."/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
