<Window x:Class="NIM.TraditionalConvert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NIM"
        mc:Ignorable="d"
        Title="TraditionalConvert" Height="260" Width="300" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Background="#FF232222">
        
        <StackPanel Orientation="Vertical">
            <TextBox>
                Processed by 繁化姬: https://zhconvert.org
            </TextBox>

            <Label Foreground="White" HorizontalAlignment="Center" Margin="0 5 0 0">
                Simplified To Traditional
            </Label>

            <Border CornerRadius="9" Cursor="Hand" Background="#FF585858" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 50 0 0" Padding="10 5 10 5" PreviewMouseDown="ConvertCurrent_PreviewMouseDown">
                <Label Foreground="White">
                    Current to Traditional
                </Label>
            </Border>

            <Border CornerRadius="9" Cursor="Hand" Background="#FF585858" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 15 0 0" Padding="10 5 10 5"  PreviewMouseDown="ConvertAll_PreviewMouseDown">
                <Label Foreground="White" Name="ConvertAllBtn">
                    All to Traditional
                </Label>
            </Border>
        </StackPanel>

      

    </Grid>
</Window>
