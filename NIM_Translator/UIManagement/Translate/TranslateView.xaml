                                    </Label>
                                </Border>

                                <Border Name="ShowHistoryButton" Style="{DynamicResource LiteButton}" PreviewMouseDown="ShowHistory" ToolTip="Undo last operation (Ctrl+↑),Redo last operation (Ctrl+↓)">
