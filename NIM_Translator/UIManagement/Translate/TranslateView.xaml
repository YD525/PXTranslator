                            <StackPanel Orientation="Horizontal" Grid.Column="0" Name="CurrentKeyBox">
                                <TextBox Name="CurrentLog" IsTabStop="True" Style="{DynamicResource LogText}" Margin="5 0 0 0">

                                </TextBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Margin="0 5 5 5">

                                <Label Style="{DynamicResource CaptionTextA}" Margin="5 0 0 0" Name="UIAutoWordCompletion">
