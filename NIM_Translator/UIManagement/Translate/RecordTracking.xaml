<Window x:Class="NIM.RecordTracking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NIM"
        mc:Ignorable="d"
        Title="RecordTracking" Height="800" Width="350"
        Style="{DynamicResource DefWin}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual" Closed="Window_Closed" ResizeMode="NoResize">

    <Border Background="Transparent" CornerRadius="9">
        <Border Background="#FF282828" CornerRadius="9">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Name="NpcRow" Height="1*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Name="RelatedTextRow" Height="1*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Name="DialogueRow" Height="1*"/>
                </Grid.RowDefinitions>

                <!--NPC-->
                <Border Grid.Row="0" Background="Transparent" Cursor="Hand" Margin="0 0 0 6" PreviewMouseDown="NpcHeader_PreviewMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="4" Height="14" Background="#FFF7F1BA" CornerRadius="2" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="Related NPCs" Foreground="White" FontWeight="Bold" FontSize="13" Margin="6 0 0 0" VerticalAlignment="Center"/>

                        <Path Grid.Column="3" Name="NpcChevron" Width="12" Height="7" Stretch="Uniform" Margin="0 0 4 0"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              Data="M1,1 L7,7 L13,1"
                              Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="NpcChevronRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Name="NpcContentHost" ClipToBounds="True" Margin="0 0 0 10">
                    <ScrollViewer Name="NpcScrollViewer" Style="{DynamicResource for_scrollviewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="NpcListPanel" Orientation="Vertical"/>
                    </ScrollViewer>
                </Border>

                <!--Related Text-->
                <Border Grid.Row="2" Background="Transparent" Cursor="Hand" Margin="0 0 0 6" PreviewMouseDown="RelatedTextHeader_PreviewMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="4" Height="14" Background="#FFF7F1BA" CornerRadius="2" VerticalAlignment="Center"/>
                        <Label Grid.Column="1" Content="Related Text Entries" Foreground="White" FontWeight="Bold" FontSize="13" Margin="6 0 0 0" VerticalAlignment="Center"/>

                        <Path Grid.Column="3" Name="RelatedTextChevron" Width="12" Height="7" Stretch="Uniform" Margin="0 0 4 0"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              Data="M1,1 L7,7 L13,1"
                              Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="RelatedTextChevronRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Name="RelatedTextContentHost" ClipToBounds="True" Margin="0 0 0 10">
                    <ScrollViewer Name="RelatedTextScrollViewer" Style="{DynamicResource for_scrollviewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="RelatedTextListPanel" Orientation="Vertical"/>
                    </ScrollViewer>
                </Border>

                <!--Dialogue Scene-->
                <Border Grid.Row="4" Background="Transparent" Cursor="Hand" Margin="0 0 0 6" PreviewMouseDown="DialogueHeader_PreviewMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="4" Height="14" Background="#FFF7F1BA" CornerRadius="2" VerticalAlignment="Center"/>
                        <Label Name="AutoLabName" Grid.Column="1" Content="Related Dialogue Scenes" Foreground="White" FontWeight="Bold" FontSize="13" Margin="6 0 0 0" VerticalAlignment="Center"/>

                        <Path Grid.Column="3" Name="DialogueChevron" Width="12" Height="7" Stretch="Uniform" Margin="0 0 4 0"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              Data="M1,1 L7,7 L13,1"
                              Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="DialogueChevronRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Border>
                <Border Grid.Row="5" Name="DialogueContentHost" ClipToBounds="True" Margin="0 0 0 10">
                    <ScrollViewer Name="DialogueScrollViewer" Style="{DynamicResource for_scrollviewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="DialogueListPanel" Orientation="Vertical"/>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>
    </Border>
</Window>
