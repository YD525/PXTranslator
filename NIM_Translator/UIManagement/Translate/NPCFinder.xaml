<Window x:Class="NIM.NPCFinder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NIM"
        mc:Ignorable="d"
        Title="NPC Dialogue Locator" Height="150" Width="300" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Background="#FF2F2F2F">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Label Foreground="White">
                    NpcName
                </Label>
                <TextBox Name="NpcName" Width="150" TextChanged="TextBox_TextChanged">
                </TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="220" Name="NpcNames" Margin="0 5 0 0" SelectionChanged="NpcNames_SelectionChanged">
                </ComboBox>
            </StackPanel>

            <Button Margin="0 5 0 0" Click="Button_Click">
                Jump to
            </Button>
        </StackPanel>
    </Grid>
</Window>
