<Window x:Class="NIM.UIManagement.PlatformConfigStyleWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NIM.UIManagement"
        mc:Ignorable="d"
        Title="PlatformConfigStyleWin" Height="750" Width="800">
    <Grid Background="Black">
        <StackPanel Orientation="Vertical" Margin="5 0 5 0" VerticalAlignment="Center">


            <Border BorderThickness="1" BorderBrush="#FF3F3E3E" CornerRadius="5" Height="170" Margin="0 5 0 5" Name="CloudAIConfig">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="-1 -1 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="5 0 0 0" Grid.Row="0" HorizontalAlignment="Left" >
                            <StackPanel Orientation="Horizontal" Margin="15 0 15 0">
                                <Label VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFAE306">
                                    ChatGpt
                                </Label>
                                <Ellipse Width="8" Height="8" Fill="#FF14C1DC" VerticalAlignment="Center">
                                </Ellipse>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1" Background="#FF303030" Margin="0 1 0 0">
                            <StackPanel Orientation="Horizontal">
                                <Label Foreground="White" VerticalAlignment="Center" Cursor="Hand" Margin="5 0 0 0">
                                    Document: 
                                </Label>
                                <Border Margin="5 0 0 0" CornerRadius="5" VerticalAlignment="Center" Background="#FF620A0A" Cursor="Hand">
                                    <Label Foreground="White" VerticalAlignment="Center" FontSize="10">
                                        DeletePlatform
                                    </Label>
                                </Border>
                            </StackPanel>

                        </Grid>
                        <Border Grid.Column="2" Background="#FF303030" CornerRadius="0 5 0 0" Margin="-1 0 0 0" BorderThickness="0 1 0 0" BorderBrush="#FF3F3E3E" >
                        </Border>
                    </Grid>


                    <Grid Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Label Foreground="White" Grid.Row="0" VerticalAlignment="Center" Margin="10 0 0 0">
                                    ApiKey:
                                </Label>
                                
                                <Border Style="{StaticResource SettingInputBorder}" Width="180" Margin="0 0 5 0" VerticalAlignment="Center">
                                    <TextBox  Style="{StaticResource SettingTextBox}"/>
                                </Border>

                                <Border Style="{StaticResource SettingActionButton}" VerticalAlignment="Center">
                                    <TextBlock Text="Add" Style="{StaticResource SettingActionButtonText}"/>
                                </Border>

                                <Border Style="{StaticResource SettingActionButton}" VerticalAlignment="Center">
                                    <TextBlock Text="Remove" Style="{StaticResource SettingActionButtonText}"/>
                                </Border>

                                <Label Foreground="White" Grid.Row="0" VerticalAlignment="Center" Margin="5 0 0 0">
                                    Model:
                                </Label>

                                <Border Style="{StaticResource SettingInputBorder}" Width="100" Margin="0 0 5 0" VerticalAlignment="Center">
                                    <TextBox  Style="{StaticResource SettingTextBox}"/>
                                </Border>

                                <ComboBox Style="{DynamicResource SettingComboBox}" Width="100" Margin="5 5 0 5" VerticalAlignment="Center">
                                </ComboBox>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Visible" Style="{DynamicResource for_scrollviewer}" Grid.Row="1" >
                                <ListBox Background="{x:Null}" Foreground="White" BorderThickness="0">

                                </ListBox>
                            </ScrollViewer>


                        </Grid>

                    </Grid>

                </Grid>
            </Border>

            <Border BorderThickness="1" BorderBrush="#FF3F3E3E" CornerRadius="5" Height="85" Margin="0 5 0 5" Name="LocalAIConfig">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="-1 -1 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="5 0 0 0" Grid.Row="0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="15 0 15 0">
                                <Label VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFAE306">
                                    LMStudio
                                </Label>
                                <Ellipse Width="8" Height="8" Fill="#FF14C1DC" VerticalAlignment="Center">
                                </Ellipse>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1" Background="#FF303030" Margin="0 1 0 0">
                            <StackPanel Orientation="Horizontal">
                                <Label Foreground="White" VerticalAlignment="Center" Cursor="Hand" Margin="5 0 0 0">
                                    Document: 
                                </Label>
                                <Border Margin="5 0 0 0" CornerRadius="5" VerticalAlignment="Center" Background="#FF620A0A" Cursor="Hand">
                                    <Label Foreground="White" VerticalAlignment="Center" FontSize="10">
                                        DeletePlatform
                                    </Label>
                                </Border>
                            </StackPanel>

                        </Grid>
                        <Border Grid.Column="2" Background="#FF303030" CornerRadius="0 5 0 0" Margin="-1 0 0 0" BorderThickness="0 1 0 0" BorderBrush="#FF3F3E3E" >
                        </Border>
                    </Grid>


                    <Grid Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Label Foreground="White" Grid.Row="0" VerticalAlignment="Center" Margin="10 0 0 0">
                                    Port:
                                </Label>
                                
                                <Border Style="{StaticResource SettingInputBorder}" Width="80" Margin="0 0 5 0" VerticalAlignment="Center">
                                    <TextBox  Style="{StaticResource SettingTextBox}"/>
                                </Border>

                                <Label Foreground="White" Grid.Row="0" VerticalAlignment="Center" Margin="5 0 0 0">
                                    Current Model:
                                </Label>

                                <Label Foreground="White" VerticalAlignment="Center">

                                </Label>
                            </StackPanel>
                        </Grid>

                    </Grid>

                </Grid>
            </Border>

            <Border BorderThickness="1" BorderBrush="#FF3F3E3E" CornerRadius="5" Height="150" Margin="0 5 0 5" Name="TraditionalConfig">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="-1 -1 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="5 0 0 0" Grid.Row="0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="15 0 15 0">
                                <Label VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFAE306">
                                    DeepL
                                </Label>
                                <Ellipse Width="8" Height="8" Fill="#FFF5668C" VerticalAlignment="Center">
                                </Ellipse>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1" Background="#FF303030" Margin="0 1 0 0">
                            <StackPanel Orientation="Horizontal">
                                <Label Foreground="White" VerticalAlignment="Center" Cursor="Hand" Margin="5 0 0 0">
                                    Document: 
                                </Label>
                                <Border Margin="5 0 0 0" CornerRadius="5" VerticalAlignment="Center" Background="#FF620A0A" Cursor="Hand">
                                    <Label Foreground="White" VerticalAlignment="Center" FontSize="10">
                                        DeletePlatform
                                    </Label>
                                </Border>
                            </StackPanel>

                        </Grid>
                        <Border Grid.Column="2" Background="#FF303030" CornerRadius="0 5 0 0" Margin="-1 0 0 0" BorderThickness="0 1 0 0" BorderBrush="#FF3F3E3E" >
                        </Border>
                    </Grid>


                    <Grid Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Label Foreground="White" Grid.Row="0" VerticalAlignment="Center" Margin="10 0 0 0">
                                    ApiKey:
                                </Label>

                                <Border Style="{StaticResource SettingInputBorder}" Width="180" Margin="0 0 5 0" VerticalAlignment="Center">
                                    <TextBox  Style="{StaticResource SettingTextBox}"/>
                                </Border>
                              
                                <Border Style="{StaticResource SettingActionButton}" VerticalAlignment="Center">
                                    <TextBlock Text="Add" Style="{StaticResource SettingActionButtonText}"/>
                                </Border>

                                <Border Style="{StaticResource SettingActionButton}" VerticalAlignment="Center">
                                    <TextBlock Text="Remove" Style="{StaticResource SettingActionButtonText}"/>
                                </Border>

                                <CheckBox Foreground="White" VerticalAlignment="Center" Margin="5 0 0 0" Visibility="Collapsed">
                                    IsFree
                                </CheckBox>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Visible" Style="{DynamicResource for_scrollviewer}" Grid.Row="1" >
                                <ListBox Background="{x:Null}" Foreground="White" BorderThickness="0">

                                </ListBox>
                            </ScrollViewer>


                        </Grid>

                    </Grid>

                </Grid>
            </Border>
        </StackPanel>
       
    </Grid>
</Window>
