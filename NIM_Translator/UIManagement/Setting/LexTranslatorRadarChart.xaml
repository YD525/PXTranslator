<UserControl x:Class="NIM.NIMRadarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="600" Height="480">

    <UserControl.Resources>
        <SolidColorBrush x:Key="RadarStrokeBrush" Color="#FFF7F1BA" />
        <SolidColorBrush x:Key="RadarFillBrush" Color="#33F7F1BA" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#FF3A3A3A" />
        <SolidColorBrush x:Key="TextMainBrush" Color="White" />
        <SolidColorBrush x:Key="TextSubBrush" Color="#FFA0A0A0" />
        <SolidColorBrush x:Key="AccentBarBrush" Color="#FFF7F1BA" />
        <DropShadowEffect x:Key="AccentGlow" Color="#FFF7F1BA" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
    </UserControl.Resources>

    <Border Background="Transparent" CornerRadius="9">
        <Border Background="#FF282828" CornerRadius="9" Padding="20">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
                    <Border Width="4" Height="16" Background="{StaticResource AccentBarBrush}" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="NIM Engine"
                               Foreground="{StaticResource TextMainBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Canvas x:Name="RadarCanvas" Width="560" Height="400" Margin="0,30,0,0">


                    <Polygon x:Name="GridOuter" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1.5" />
                    <Polygon x:Name="GridA" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />
                    <Polygon x:Name="GridB" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />
                    <Polygon x:Name="GridC" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />
                    <Polygon x:Name="GridD" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />


                    <Line x:Name="AxisTop" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />
                    <Line x:Name="AxisTopRight" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />
                    <Line x:Name="AxisBottomRight" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />
                    <Line x:Name="AxisBottomLeft" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />
                    <Line x:Name="AxisTopLeft" Stroke="{StaticResource GridLineBrush}" StrokeThickness="1" />


                    <TextBlock x:Name="LabelA" Text="A" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
                    <TextBlock x:Name="LabelB" Text="B" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
                    <TextBlock x:Name="LabelC" Text="C" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
                    <TextBlock x:Name="LabelD" Text="D" FontSize="11" Foreground="{StaticResource TextSubBrush}" />


                    <Polygon x:Name="DataPolygon"
                             Fill="{StaticResource RadarFillBrush}"
                             Stroke="{StaticResource RadarStrokeBrush}"
                             StrokeThickness="2"
                             StrokeLineJoin="Round"
                             Effect="{StaticResource AccentGlow}" />


