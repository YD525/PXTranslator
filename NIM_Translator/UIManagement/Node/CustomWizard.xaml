<Window x:Class="NIM.CustomWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NIM"
        mc:Ignorable="d"
        Title="CustomTranslationPlatformWizard" Height="700" Width="750" WindowStartupLocation="CenterOwner"  Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="#FF424242">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="39"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="5 0 5 0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label Name="StepLab" VerticalAlignment="Center" FontSize="17" FontWeight="DemiBold" Foreground="White" Background="#FF2F2F2F">
                    1/3
                </Label>

                <Label Name="Tittle" FontSize="13" VerticalAlignment="Center" Foreground="White">
                    Add Translation Platform – Add Platform
                </Label>
            </StackPanel>
        </Grid>

        <Grid Name="Views" Grid.Row="1" Margin="5 0 5 0" VerticalAlignment="Center">
            <Grid Name="View1" Visibility="Visible">
                <StackPanel Orientation="Vertical">
                    <TextBox BorderThickness="0" BorderBrush="{x:Null}" IsReadOnly="True" Background="{x:Null}" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True">
                        Select the type of translation platform you want to add. Please make sure to select the correct one from the drop-down menu below, whether it's an AI platform or a traditional translation platform.
                    </TextBox>
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0" HorizontalAlignment="Center">
                        <Label Foreground="White">
                            Platform Type
                        </Label>
                        <ComboBox Width="100" VerticalContentAlignment="Center" Name="PlatformType" SelectionChanged="PlatformType_SelectionChanged">

                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0" HorizontalAlignment="Center">
                        <Label Foreground="White">
                            Platform Name
                        </Label>
                        <TextBox Width="100" VerticalContentAlignment="Center" Name="PlatformName">

                        </TextBox>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Name="View2" Visibility="Hidden">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <TextBox BorderThickness="0" BorderBrush="{x:Null}" IsReadOnly="True" Background="{x:Null}" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True">
                            Fill in the URL, Header and Payload below. Every field that gets detected shows up as its own row underneath — just pick the automatic field you want from that row's dropdown, or type a fixed value directly. No separate list to click through. Click "Test Call" to verify the interface responds normally.
                        </TextBox>

                        <TextBlock Name="AutomaticFieldsHint" Foreground="#FF04B7E5" Margin="0 5 0 5" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <Label Foreground="White">
                                Test ApiKey
                            </Label>
                            <TextBox Name="TestApiKey" TextChanged="TestApiKey_TextChanged" Width="200" VerticalContentAlignment="Center">
                            </TextBox>

                            <Label Foreground="White" Name="TestModelCap">
                                Test Model
                            </Label>
                            <TextBox Name="TestModel" TextChanged="TestModel_TextChanged" Width="200" VerticalContentAlignment="Center">
                            </TextBox>
                        </StackPanel>

                        <Label Foreground="White">
                            URL
                        </Label>
                        <TextBox Name="Url" TextChanged="Url_TextChanged" TextWrapping="Wrap" AcceptsReturn="True" Height="45" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        </TextBox>
                        <StackPanel Name="UrlBindings" Orientation="Vertical" Margin="0 3 0 8">
                        </StackPanel>

                        <Label Foreground="White">
                            Header
                        </Label>
                        <TextBox Name="Header" TextChanged="Header_TextChanged" TextWrapping="Wrap" AcceptsReturn="True" Height="45" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        </TextBox>
                        <StackPanel Name="HeaderBindings" Orientation="Vertical" Margin="0 3 0 8">
                        </StackPanel>

                        <Label Foreground="White">
                            Payload (Request Body)
                        </Label>
                        <TextBox Name="Payload" TextChanged="Payload_TextChanged" TextWrapping="Wrap" AcceptsReturn="True" Height="70" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        </TextBox>
                        <StackPanel Name="PayloadBindings" Orientation="Vertical" Margin="0 3 0 8">
                        </StackPanel>

                        <CheckBox Name="IsPost" IsChecked="True" Click="IsPost_Click" Foreground="White">
                            IsPost
                        </CheckBox>

                        <Border Name="TestCallBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 5 0 5" PreviewMouseDown="TestCall">
                            <Label Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False" HorizontalAlignment="Center">
                                Test Call
                            </Label>
                        </Border>

                        <Label Foreground="White">
                            Response
                        </Label>
                        <TextBox Name="Response" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="50" Foreground="White" Background="{x:Null}" BorderThickness="0" BorderBrush="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        </TextBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Name="View3" Visibility="Hidden">
                <StackPanel Orientation="Vertical">

                    <TextBox BorderThickness="0" BorderBrush="{x:Null}" IsReadOnly="True" Background="{x:Null}" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True">
                        We now need to define a rule to extract the content returned by the request.
                        Note that if the returned content is JSON, you only need to select FieldName and leave the other fields blank. If the returned content is not JSON, the following two methods are provided: Extract Between,Extract After.
                    </TextBox>

                    <Label Foreground="White" Margin="0 5 0 0">
                        Response (Click on the ListBox on the right to apply the field to FieldName)
                    </Label>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Name="P_Response" Grid.Column="0" TextWrapping="Wrap" AcceptsReturn="True" Height="300" ScrollViewer.VerticalScrollBarVisibility="Auto">

                        </TextBox>

                        <ListBox SelectionChanged="P_ResponseTags_SelectionChanged" Foreground="White" Name="P_ResponseTags" Grid.Column="1" BorderBrush="{x:Null}" Background="#FF5F5F5F" Height="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        </ListBox>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <CheckBox Foreground="White" Margin="0 5 0 5" IsChecked="True" Name="IsJson">
                            IsJson
                        </CheckBox>
                        <Label Foreground="#FF04B7E5" Name="FieldName">
                            FieldName:
                        </Label>
                    </StackPanel>

                    <TextBox BorderThickness="0" BorderBrush="{x:Null}" IsReadOnly="True" Background="{x:Null}" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True">
                        If the API returns content that is not JSON, the following are special handling strategies.
                    </TextBox>

                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                        <Label Foreground="White">
                            Extract Between
                        </Label>
                        <TextBox Width="100" Margin="0 0 5 0" Name="LeftStr" TextChanged="LeftStr_TextChanged">
                        </TextBox>
                        <TextBox Width="100" Name="RightStr" TextChanged="RightStr_TextChanged">
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                        <Label Foreground="White">
                            Extract After
                        </Label>
                        <TextBox Width="100" Name="SplitStr" TextChanged="SplitStr_TextChanged">
                        </TextBox>
                    </StackPanel>

                    <Border Name="TestGetResponseBtn" PreviewMouseDown="TestGetResponseBtn_PreviewMouseDown" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 5 0 5">
                        <Label Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False" HorizontalAlignment="Center">
                            Test Call
                        </Label>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="5 0 5 5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Border Name="BackBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 0 5 0" Visibility="Collapsed" PreviewMouseDown="Back">
                    <Label FontSize="15" Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False">
                        Back
                    </Label>
                </Border>

                <Border Name="NextBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" PreviewMouseDown="Next" Visibility="Visible">
                    <Label FontSize="15" Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False">
                        Next
                    </Label>
                </Border>

                <Border PreviewMouseDown="FinishBtn_PreviewMouseDown" Name="FinishBtn" CornerRadius="6" BorderThickness="1" BorderBrush="White" Background="#FF2F2F2F" Cursor="Hand" Margin="0 0 5 0" Visibility="Collapsed">
                    <Label FontSize="15" Foreground="White" VerticalAlignment="Center" IsHitTestVisible="False">
                        Finish
                    </Label>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
