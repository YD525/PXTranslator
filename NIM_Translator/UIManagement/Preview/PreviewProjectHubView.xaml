<UserControl x:Class="NIM.UIManagement.Preview.PreviewProjectHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:NIM.UIManagement.Localization"
             AllowDrop="True" DragOver="ProjectHub_DragOver" Drop="ProjectHub_Drop"
             AutomationProperties.Name="{localization:PreviewMessage Projects_Title}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/PreviewControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <Style x:Key="ProjectCard" TargetType="Border">
                <Setter Property="Padding" Value="18" />
                <Setter Property="Background" Value="{StaticResource PreviewBrushSurfacePrimary}" />
                <Setter Property="BorderBrush" Value="{StaticResource PreviewBrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>
            <Style x:Key="RecentProjectItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource PreviewFocusVisual}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="Enter" Command="{Binding OpenRecentProjectCommand}"
                    CommandParameter="{Binding SelectedRecentProject}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveRecentProjectCommand}"
                    CommandParameter="{Binding SelectedRecentProject}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ProjectCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PreviewBrushTextPrimary}"
                               Text="{localization:PreviewMessage Projects_Open_Title}" />
                    <TextBlock Margin="0,5,20,0" Foreground="{StaticResource PreviewBrushTextSecondary}"
                               Text="{localization:PreviewMessage Projects_Open_Description}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="OpenProjectButton" Grid.Column="1" Style="{StaticResource PreviewButtonPrimary}"
                        Command="{Binding OpenProjectCommand}" Content="{localization:PreviewMessage Workspace_Open_Action}"
                        ToolTip="{localization:PreviewMessage Projects_Open_ToolTip}" />
                <Button Grid.Column="3" Style="{StaticResource PreviewButtonSecondary}"
                        Command="{Binding OpenLegacyWorkspaceCommand}"
                        Content="{localization:PreviewMessage Shell_Legacy_Open_Action}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ProjectCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PreviewBrushTextPrimary}"
                               Text="{localization:PreviewMessage Projects_Recent_Title}" />
                    <ListBox x:Name="RecentProjectList" Grid.Row="2" ItemsSource="{Binding RecentProjects}"
                             SelectedItem="{Binding SelectedRecentProject}"
                             ItemContainerStyle="{StaticResource RecentProjectItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                             AutomationProperties.Name="{localization:PreviewMessage Accessibility_Projects_Recent_Name}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10" Background="{StaticResource PreviewBrushSurfaceInteractive}"
                                        BorderBrush="{StaticResource PreviewBrushBorder}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PreviewBrushTextPrimary}"
                                                           Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3"
                                                        Background="{StaticResource PreviewBrushSurfaceRaised}">
                                                    <TextBlock FontSize="10" Foreground="{StaticResource PreviewBrushAccentGold}"
                                                               Text="{Binding Format}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <TextBlock FontSize="11" Foreground="{StaticResource PreviewBrushTextMuted}"
                                                           Text="{Binding LastOpenedText}" />
                                                <TextBlock Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource PreviewBrushTextSecondary}"
                                                           Text="{Binding AvailabilityText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PreviewButtonSecondary}"
                                                Command="{Binding DataContext.OpenRecentProjectCommand,
                                                    RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="{localization:PreviewMessage Projects_Recent_Open_Action}" />
                                        <Button Grid.Column="3" Style="{StaticResource PreviewButtonSecondary}"
                                                Command="{Binding DataContext.RemoveRecentProjectCommand,
                                                    RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="{localization:PreviewMessage Common_Action_Remove}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentProjects}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource PreviewBrushTextPrimary}"
                                   Text="{localization:PreviewMessage Projects_Recent_Empty_Title}" />
                        <TextBlock Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource PreviewBrushTextMuted}"
                                   Text="{localization:PreviewMessage Projects_Recent_Empty_Description}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ProjectCard}"
                    AutomationProperties.Name="{localization:PreviewMessage Accessibility_Projects_Active_Name}">
                <Grid>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PreviewBrushTextPrimary}"
                                   Text="{localization:PreviewMessage Projects_Active_Title}" />
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PreviewBrushAccentGold}"
                                       Text="{Binding ActiveProjectName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource PreviewBrushTextSecondary}"
                                       Text="{Binding ActiveProjectFormatText}" />
                            <Button Margin="0,20,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource PreviewButtonPrimary}" Command="{Binding ContinueCommand}"
                                    Content="{localization:PreviewMessage Projects_Continue_Action}" />
                        </StackPanel>
                        <StackPanel Margin="0,18,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProject}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Foreground="{StaticResource PreviewBrushTextSecondary}"
                                       Text="{localization:PreviewMessage Projects_Active_None}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Margin="0,28,0,0" Padding="14" BorderBrush="{StaticResource PreviewBrushBorderStrong}"
                                BorderThickness="1" CornerRadius="4" Background="{StaticResource PreviewBrushSurfaceCanvas}">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource PreviewBrushTextMuted}"
                                       Text="{localization:PreviewMessage Projects_Drop_Hint}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
