<Window x:Class="NIM.UIManagement.Preview.PreviewDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:NIM.UIManagement.Preview"
        Title="Phoenix Translator" Width="500" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/PreviewControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="8" Background="{StaticResource PreviewBrushSurfaceRaised}"
            BorderBrush="{StaticResource PreviewBrushBorderStrong}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="20,16,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="DialogTitle" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource PreviewBrushTextPrimary}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Width="34" Height="30" Margin="12,0,0,0"
                        Style="{StaticResource PreviewButtonSecondary}" IsCancel="True"
                        AutomationProperties.Name="{localization:PreviewMessage Common_Action_CloseDialog_Accessibility}"
                        xmlns:localization="clr-namespace:NIM.UIManagement.Localization">
                    <preview:PreviewIcon Icon="Dismiss" FontSize="{StaticResource PreviewIconSizeCompact}" />
                </Button>
            </Grid>
            <Border x:Name="SeverityBorder" Grid.Row="1" Margin="20,18,20,0" Padding="10,6"
                    Background="{StaticResource PreviewBrushSurfaceInteractive}"
                    BorderThickness="3,0,0,0">
                <TextBlock x:Name="SeverityText" FontWeight="SemiBold"
                           Foreground="{StaticResource PreviewBrushTextPrimary}" />
            </Border>
            <ScrollViewer x:Name="MessageScrollViewer" Grid.Row="2" Margin="20,14,20,0" MaxHeight="350"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DialogMessage" FontSize="13" LineHeight="19"
                           Foreground="{StaticResource PreviewBrushTextSecondary}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="20,22,20,20" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" MinWidth="96" Margin="0,0,8,0"
                        Style="{StaticResource PreviewButtonSecondary}" IsCancel="True" />
                <Button x:Name="AcceptButton" MinWidth="96" IsDefault="True" Click="AcceptButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
