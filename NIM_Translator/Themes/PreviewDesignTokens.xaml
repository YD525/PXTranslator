<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="PreviewColorSurfaceCanvas">#FF1A1A1A</Color>
    <Color x:Key="PreviewColorSurfacePrimary">#FF242424</Color>
    <Color x:Key="PreviewColorSurfaceRaised">#FF2A2A2A</Color>
    <Color x:Key="PreviewColorSurfaceInteractive">#FF303030</Color>
    <Color x:Key="PreviewColorBorder">#FF3D3D3D</Color>
    <Color x:Key="PreviewColorBorderStrong">#FF555555</Color>
    <Color x:Key="PreviewColorTextPrimary">#FFF2F2F2</Color>
    <Color x:Key="PreviewColorTextSecondary">#FFBFBFBF</Color>
    <Color x:Key="PreviewColorTextMuted">#FF888888</Color>
    <Color x:Key="PreviewColorAccentGold">#FFFAE306</Color>
    <Color x:Key="PreviewColorAccentGoldSoft">#FFF7F1BA</Color>
    <Color x:Key="PreviewColorActionBlue">#FF0B74D1</Color>
    <Color x:Key="PreviewColorFocusBlue">#FF4D8CF7</Color>
    <Color x:Key="PreviewColorSuccess">#FF55B879</Color>
    <Color x:Key="PreviewColorWarning">#FFFFB024</Color>
    <Color x:Key="PreviewColorError">#FFE05D5D</Color>
    <Color x:Key="PreviewColorInformation">#FF4D8CF7</Color>

    <SolidColorBrush x:Key="PreviewBrushSurfaceCanvas" Color="{StaticResource PreviewColorSurfaceCanvas}" />
    <SolidColorBrush x:Key="PreviewBrushSurfacePrimary" Color="{StaticResource PreviewColorSurfacePrimary}" />
    <SolidColorBrush x:Key="PreviewBrushSurfaceRaised" Color="{StaticResource PreviewColorSurfaceRaised}" />
    <SolidColorBrush x:Key="PreviewBrushSurfaceInteractive" Color="{StaticResource PreviewColorSurfaceInteractive}" />
    <SolidColorBrush x:Key="PreviewBrushBorder" Color="{StaticResource PreviewColorBorder}" />
    <SolidColorBrush x:Key="PreviewBrushBorderStrong" Color="{StaticResource PreviewColorBorderStrong}" />
    <SolidColorBrush x:Key="PreviewBrushTextPrimary" Color="{StaticResource PreviewColorTextPrimary}" />
    <SolidColorBrush x:Key="PreviewBrushTextSecondary" Color="{StaticResource PreviewColorTextSecondary}" />
    <SolidColorBrush x:Key="PreviewBrushTextMuted" Color="{StaticResource PreviewColorTextMuted}" />
    <SolidColorBrush x:Key="PreviewBrushAccentGold" Color="{StaticResource PreviewColorAccentGold}" />
    <SolidColorBrush x:Key="PreviewBrushAccentGoldSoft" Color="{StaticResource PreviewColorAccentGoldSoft}" />
    <SolidColorBrush x:Key="PreviewBrushActionBlue" Color="{StaticResource PreviewColorActionBlue}" />
    <SolidColorBrush x:Key="PreviewBrushFocusBlue" Color="{StaticResource PreviewColorFocusBlue}" />
    <SolidColorBrush x:Key="PreviewBrushSuccess" Color="{StaticResource PreviewColorSuccess}" />
    <SolidColorBrush x:Key="PreviewBrushWarning" Color="{StaticResource PreviewColorWarning}" />
    <SolidColorBrush x:Key="PreviewBrushError" Color="{StaticResource PreviewColorError}" />
    <SolidColorBrush x:Key="PreviewBrushInformation" Color="{StaticResource PreviewColorInformation}" />

    <FontFamily x:Key="PreviewFontFamilyUi">Segoe UI</FontFamily>
    <FontFamily x:Key="PreviewFontFamilyCode">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="PreviewFontSizeCaption">11</sys:Double>
    <sys:Double x:Key="PreviewFontSizeBody">13</sys:Double>
    <sys:Double x:Key="PreviewFontSizeBodyStrong">14</sys:Double>
    <sys:Double x:Key="PreviewFontSizeSection">18</sys:Double>
    <sys:Double x:Key="PreviewFontSizeTitle">24</sys:Double>
    <sys:Double x:Key="PreviewIconSizeSmall">14</sys:Double>
    <sys:Double x:Key="PreviewIconSizeCompact">16</sys:Double>
    <sys:Double x:Key="PreviewIconSizeMedium">20</sys:Double>
    <sys:Double x:Key="PreviewIconSizeLarge">24</sys:Double>

    <sys:Double x:Key="PreviewSpace1">4</sys:Double>
    <sys:Double x:Key="PreviewSpace2">8</sys:Double>
    <sys:Double x:Key="PreviewSpace3">12</sys:Double>
    <sys:Double x:Key="PreviewSpace4">16</sys:Double>
    <sys:Double x:Key="PreviewSpace5">24</sys:Double>
    <sys:Double x:Key="PreviewSpace6">32</sys:Double>
    <CornerRadius x:Key="PreviewRadiusSmall">3</CornerRadius>
    <CornerRadius x:Key="PreviewRadiusMedium">5</CornerRadius>
    <CornerRadius x:Key="PreviewRadiusLarge">8</CornerRadius>
    <Thickness x:Key="PreviewControlPaddingCompact">10,5</Thickness>
    <Thickness x:Key="PreviewControlPaddingComfortable">12,8</Thickness>
    <Thickness x:Key="PreviewIconLabelSpacing">0,0,8,0</Thickness>
    <sys:Double x:Key="PreviewControlHeightCompact">30</sys:Double>
    <sys:Double x:Key="PreviewControlHeightComfortable">38</sys:Double>
    <sys:Double x:Key="PreviewInputHeight">34</sys:Double>
    <sys:Double x:Key="PreviewNavigationWidth">216</sys:Double>
    <sys:Double x:Key="PreviewInspectorWidth">320</sys:Double>
    <sys:Double x:Key="PreviewMotionFastMilliseconds">100</sys:Double>
    <sys:Double x:Key="PreviewMotionStandardMilliseconds">160</sys:Double>
</ResourceDictionary>
