    <Style x:Key="NIMTabItem" TargetType="TabItem">
        <Setter Property="Padding" Value="12 6 8 6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Name="Root" Margin="0 0 2 0" Height="30">
                        <Border Name="TabBg" CornerRadius="8 8 0 0" Background="#FF2A2A2A">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Name="Dot" Grid.Column="0" Width="6" Height="6" Fill="#FF9A9A9A" VerticalAlignment="Center" Margin="0 0 8 0"/>

                                <TextBlock Name="Label" Grid.Column="1" Text="{TemplateBinding Header}" Foreground="#FFCFCFCF" FontSize="13.2" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <Border Name="CloseBtn" Cursor="Hand" Tag="NIMTabClose" Grid.Column="2" Width="16" Height="16" CornerRadius="4" Margin="8 0 0 0" Background="Transparent" Visibility="Collapsed">
                                    <Viewbox Width="9" Height="9" Stretch="Uniform">
                                        <Canvas Width="12" Height="12">
                                            <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="#FF9A9A9A" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Name="ActiveMark" Height="2" VerticalAlignment="Bottom" Margin="8 0 8 0" CornerRadius="2" Background="#FFF7F1BA" Visibility="Collapsed"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBg" Property="Background" Value="#FF333333"/>
                            <Setter TargetName="Label" Property="Foreground" Value="White"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#FFF7F1BA"/>
                            <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Root" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="TabBg" Property="Background" Value="#FF242424"/>
                            <Setter TargetName="Label" Property="Foreground" Value="#FFB5B5B5"/>
                            <Setter TargetName="Dot" Property="Fill" Value="#FF7A7A7A"/>
                            <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="NIMTabControl" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource NIMTabItem}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="Transparent" Padding="8 4 8 0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Name="AddTabBtn" Grid.Column="0" Cursor="Hand" Tag="NIMTabAdd" Width="22" Height="22" Margin="0 0 6 0"
                                CornerRadius="5" Background="#FF2A2A2A" VerticalAlignment="Center">
                                    <Viewbox Width="10" Height="10" Stretch="Uniform">
                                        <Canvas Width="12" Height="12">
                                            <Path Data="M6,1 L6,11 M1,6 L11,6" Stroke="#FF9A9A9A" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <Border Name="BtnScrollLeft" Grid.Column="1" Cursor="Hand" Width="20" Height="22" Margin="0 0 2 0"
                                CornerRadius="5" Background="#FF2A2A2A" Visibility="Collapsed" VerticalAlignment="Center">
                                    <Viewbox Width="8" Height="8" Stretch="Uniform">
                                        <Canvas Width="12" Height="12">
                                            <Path Data="M8,1 L3,6 L8,11" Stroke="#FF9A9A9A" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" IsHitTestVisible="False"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <ScrollViewer Name="TabScrollViewer" Grid.Column="2" ClipToBounds="True"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                    <TabPanel Name="HeaderPanel" IsItemsHost="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </ScrollViewer>

                                <Border Name="BtnScrollRight" Grid.Column="3" Cursor="Hand" Width="20" Height="22" Margin="2 0 0 0"
                                CornerRadius="5" Background="#FF2A2A2A" Visibility="Collapsed" VerticalAlignment="Center">
                                    <Viewbox Width="8" Height="8" Stretch="Uniform">
                                        <Canvas Width="12" Height="12">
                                            <Path Data="M4,1 L9,6 L4,11" Stroke="#FF9A9A9A" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" IsHitTestVisible="False"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                            </Grid>
                        </Border>
                        <Border>
                            <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModButtonStyle" TargetType="Border">
        <Setter Property="Background" Value="#252525"/>
        <Setter Property="BorderBrush" Value="#3D3D3D"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#303030"/>
                <Setter Property="BorderBrush" Value="#505050"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ===================== Settings Page Styles ===================== -->
    <SolidColorBrush x:Key="SettingAccentBrush" Color="#FFFAE306"/>
    <SolidColorBrush x:Key="SettingMutedBrush" Color="#FF909090"/>

    <Style x:Key="SettingNavItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="4 4 0 0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#14FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingNavText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource SettingMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingCard" TargetType="Border">
        <Setter Property="Background" Value="#FF242424"/>
        <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="SettingSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SettingAccentBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFC0C0C0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FF808080"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>


    <Style x:Key="SettingHintR" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="#FF808080"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="SettingInputBorder" TargetType="Border">
        <Setter Property="Background" Value="#FF1A1A1A"/>
        <Setter Property="BorderBrush" Value="#FF3D3D3D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SettingAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingActionButton" TargetType="Border">
        <Setter Property="Background" Value="#FF2A2A2A"/>
        <Setter Property="BorderBrush" Value="#FF444444"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SettingAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingActionButtonText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFD0D0D0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="SettingToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="38" Height="20" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" Background="#FF3A3A3A" BorderBrush="#FF505050" BorderThickness="1"/>
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#FFB0B0B0" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#FFFAE306"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#FFFAE306"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#FF1A1A1A"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#FF1A1A1A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#FF3D3D3D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleBtn" Background="Transparent" BorderThickness="0" Panel.ZIndex="2"
                                   IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="MainBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0" Stroke="#FF909090" StrokeThickness="1.5"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="#FF242424" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220" Margin="0,2,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource SettingAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModActionButton" TargetType="Button">

        <Setter Property="Foreground" Value="#FFE8E8E8"/>
        <Setter Property="Background" Value="#303030"/>
        <Setter Property="BorderBrush" Value="#505050"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,5"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">

                        <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#404040"/>
                            <Setter TargetName="ButtonBorder"
                                Property="BorderBrush"
                                Value="#FFF7F1BA"/>
                        </Trigger>


                        <!-- Press -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#505050"/>
                        </Trigger>


                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity"
                                Value="0.5"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>