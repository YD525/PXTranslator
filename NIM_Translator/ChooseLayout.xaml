<Window x:Class="NIM.ChooseLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NIM"
        Style="{DynamicResource DefWin}"
        mc:Ignorable="d"
        Title="Select Layout" Height="380" Width="640" WindowStartupLocation="CenterScreen">
    <Border Background="#FF282828" CornerRadius="12" MouseDown="WinHead_MouseLeftButtonDown">
        <Grid>
            <Grid Panel.ZIndex="999">
                <Border VerticalAlignment="Top" Style="{DynamicResource BlockButton}" PreviewMouseDown="Close_PreviewMouseDown" HorizontalAlignment="Right" Margin="0,10,10,0" Cursor="Hand">
                    <ContentControl Style="{DynamicResource CloseIconStyle}"/>
                </Border>
            </Grid>

            <Grid Margin="24,30,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,0,0,15">
                    <TextBlock Text="Select Workspace Layout" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose the environment that best fits your workflow" Foreground="#FF8E8E93" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border PreviewMouseDown="Modern_PreviewMouseDown" Name="Modern" Grid.Column="0" Margin="8" CornerRadius="10" 
                            Background="#FF222121" BorderThickness="1.5" BorderBrush="#FF3A3A3C" 
                            Padding="16" Cursor="Hand" MouseEnter="Modern_MouseEnter" MouseLeave="Modern_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock Text="Modern" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Grid Name="ModernState">
                                    <Border HorizontalAlignment="Right" Background="#3334C759" CornerRadius="4" Padding="5" Visibility="Visible">
                                        <TextBlock Text="Ready" Foreground="#34C759" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" Background="#33FF9500" CornerRadius="4" Padding="5" Visibility="Collapsed">
                                        <TextBlock Text="In Dev" Foreground="#FF9500" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DockPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12">
                                <TextBlock Text="Focused on Editor View" Foreground="#FFE5E5EA" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                                <TextBlock Text="Designed for core text processing and immersive editing." Foreground="#FF8E8E93" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="16"/>
                            </StackPanel>

                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#FF4C4C4F" Padding="0,8,0,0">
                                <TextBlock Text="Designed by Wuerfelhusten" Foreground="#FFAEAEB4" FontSize="11" FontStyle="Italic"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border PreviewMouseDown="Classic_PreviewMouseDown" Name="Classic" Grid.Column="1" Margin="8" CornerRadius="10" 
                            Background="#FF222121" BorderThickness="1.5" BorderBrush="#FF3A3A3C" 
                            Padding="16" Cursor="Hand" MouseEnter="Classic_MouseEnter" MouseLeave="Classic_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock Text="Classic" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Grid Name="ClassicState">
                                    <Border HorizontalAlignment="Right" Background="#3334C759" CornerRadius="4" Padding="5" Visibility="Visible">
                                        <TextBlock Text="Ready" Foreground="#34C759" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" Background="#33FF9500" CornerRadius="4" Padding="5" Visibility="Collapsed">
                                        <TextBlock Text="In Dev" Foreground="#FF9500" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DockPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12">
                                <TextBlock Text="Multi-Window Layout" Foreground="#FFE5E5EA" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                                <TextBlock Text="Ideal for multitasking and multi-module comprehensive workflow." Foreground="#FF8E8E93" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="16"/>
                            </StackPanel>

                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#FF4C4C4F" Padding="0,8,0,0">
                                <TextBlock Text="Designed by YD525" Foreground="#FFAEAEB4" FontSize="11" FontStyle="Italic"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>