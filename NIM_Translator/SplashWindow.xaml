<Window x:Class="NIM.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NIM"
        xmlns:localization="clr-namespace:NIM.UIManagement.Localization"
        mc:Ignorable="d"
        Title="Lex" Height="230" Width="340" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/PreviewControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="5" CornerRadius="8" Background="#FF282828" PreviewMouseLeftButtonDown="WinHead_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>

            <Border Style="{DynamicResource BlockButton}" Grid.Column="6" PreviewMouseDown="Close_PreviewMouseDown" Grid.Row="0" HorizontalAlignment="Right" Margin="0 0 10 0" Cursor="Hand">
                <ContentControl Style="{DynamicResource CloseIconStyle}" Grid.Column="3"/>
            </Border>

            <StackPanel x:Name="LoadingPanel" Orientation="Vertical" VerticalAlignment="Center" Grid.Row="0" Grid.RowSpan="2">

                <Grid Margin="0 5 0 5">
                    <Grid.Resources>
                        <Style x:Key="ellipse" TargetType="Ellipse">
                            <Setter Property="Width" Value="7.5"/>
                            <Setter Property="Height" Value="7.5"/>
                            <Setter Property="Canvas.Left" Value="21.25"/>
                            <Setter Property="Fill" Value="White"/>
                            <Setter Property="RenderTransformOrigin" Value="0.5,3.33"/>
                        </Style>
                        <PowerEase x:Key="powerease" Power="3" EasingMode="EaseInOut"/>
                    </Grid.Resources>
                    <Canvas Width="50" Height="50">
                        <Canvas.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="e1" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.1" DecelerationRatio="0.9"/>
                                        <DoubleAnimation Storyboard.TargetName="e2" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.3" DecelerationRatio="0.7"/>
                                        <DoubleAnimation Storyboard.TargetName="e3" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.5" DecelerationRatio="0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="e4" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.7" DecelerationRatio="0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="e5" To="360" Duration="0:0:2" EasingFunction="{StaticResource powerease}" AccelerationRatio="0.9" DecelerationRatio="0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Canvas.Triggers>
                        <Ellipse Name="e1" Style="{StaticResource ellipse}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Name="e2" Style="{StaticResource ellipse}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Name="e3" Style="{StaticResource ellipse}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Name="e4" Style="{StaticResource ellipse}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Name="e5" Style="{StaticResource ellipse}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22">
                        NIM Translator
                    </Label>
                    <Border CornerRadius="3" Background="#FF303030" VerticalAlignment="Center" Margin="5 0 0 0">
                        <Label Foreground="White" VerticalAlignment="Center" FontSize="10" Name="Version">

                        </Label>
                    </Border>
                </StackPanel>


                <Label Name="Log" Foreground="White" Opacity="0.6" HorizontalAlignment="Center">
                    Initializing...
                </Label>
            </StackPanel>

            <StackPanel x:Name="FailurePanel" Grid.Row="0" Grid.RowSpan="2" Margin="28,34,28,18"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource PreviewBrushTextPrimary}"
                           Text="{localization:PreviewMessage Startup_Failed_Title}" />
                <TextBlock Margin="0,10,0,16" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource PreviewBrushTextSecondary}"
                           Text="{localization:PreviewMessage Startup_Failed_Message}" />
                <TextBlock x:Name="FailureDetail" Margin="0,0,0,12" FontSize="10" TextAlignment="Center"
                           Foreground="{StaticResource PreviewBrushTextMuted}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button MinWidth="90" Style="{StaticResource PreviewButtonPrimary}" Click="Retry_Click"
                            Content="{localization:PreviewMessage Startup_Retry_Action}" />
                    <Button MinWidth="90" Margin="8,0,0,0" Style="{StaticResource PreviewButtonSecondary}" Click="Exit_Click"
                            Content="{localization:PreviewMessage Startup_Exit_Action}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" Background="#FFFAE306" CornerRadius="0 0 8 8">
            </Border>
        </Grid>
        
    </Border>
</Window>
