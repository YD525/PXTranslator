<?xml version="1.0"?>
<SyntaxDefinition name="CSharpStyle" extensions=".slua;.lua"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

	<!-- ═══════════════════════════════════════════
       VSCode Dark+ Color Scheme
       Keywords    : #569CD6 blue
       Control flow: #C586C0 purple
       Types       : #4EC9B0 teal
       Methods     : #DCDCAA yellow
       Strings     : #CE9178 orange-brown
       Numbers     : #B5CEA8 light green
       Comments    : #6A9955 green
       Punctuation : #D4D4D4 light gray
       Modifiers   : #569CD6 blue
       this/null   : #569CD6 blue
       SystemOp    : #4EC9B0 teal
  ═══════════════════════════════════════════ -->

	<Color name="Comment"       foreground="#6A9955" />
	<Color name="String"        foreground="#CE9178" />
	<Color name="StringSingle"  foreground="#CE9178" />
	<Color name="MethodCall"    foreground="#DCDCAA" />
	<Color name="NumberLiteral" foreground="#B5CEA8" />
	<Color name="Keywords"      foreground="#569CD6" fontWeight="bold" />
	<Color name="ControlFlow"   foreground="#C586C0" fontWeight="bold" />
	<Color name="Visibility"    foreground="#569CD6" />
	<Color name="NilKeyword"    foreground="#569CD6" />
	<Color name="ScriptType"    foreground="#4EC9B0" />
	<Color name="SystemDef"     foreground="#569CD6" />
	<Color name="SystemOp"      foreground="#4EC9B0" />
	<Color name="Punctuation"   foreground="#D4D4D4" />

	<!-- ═══════════════════════════════════════════
       COMMENT MARKERS
  ═══════════════════════════════════════════ -->
	<RuleSet name="CommentMarkerSet">
		<Keywords fontWeight="bold" foreground="#FF8C00">
			<Word>TODO</Word>
			<Word>FIXME</Word>
			<Word>HACK</Word>
			<Word>UNDONE</Word>
		</Keywords>
	</RuleSet>

	<!-- ═══════════════════════════════════════════
       MAIN RULESET
  ═══════════════════════════════════════════ -->
	<RuleSet>

		<!-- ─── COMMENTS ─── -->
		<Span color="Comment" ruleSet="CommentMarkerSet">
			<Begin>//</Begin>
		</Span>

		<!-- ─── STRINGS ─── -->
		<Span color="String">
			<Begin>"</Begin>
			<End>"</End>
			<RuleSet>
				<Span begin="\\" end="." />
			</RuleSet>
		</Span>

		<Span color="StringSingle">
			<Begin>'</Begin>
			<End>'</End>
			<RuleSet>
				<Span begin="\\" end="." />
			</RuleSet>
		</Span>

		<!-- ─── CONTROL FLOW ─── -->
		<Keywords color="ControlFlow">
			<Word>if</Word>
			<Word>If</Word>
			<Word>else</Word>
			<Word>Else</Word>
			<Word>elseif</Word>
			<Word>ElseIf</Word>
			<Word>endif</Word>
			<Word>EndIf</Word>
			<Word>for</Word>
			<Word>foreach</Word>
			<Word>while</Word>
			<Word>do</Word>
			<Word>break</Word>
			<Word>continue</Word>
			<Word>return</Word>
			<Word>Return</Word>
			<Word>repeat</Word>
			<Word>until</Word>
			<Word>in</Word>
			<Word>end</Word>
			<Word>then</Word>
			<Word>switch</Word>
			<Word>case</Word>
			<Word>default</Word>
		</Keywords>

		<!-- ─── KEYWORDS ─── -->
		<Keywords color="Keywords">
			<Word>and</Word>
			<Word>or</Word>
			<Word>not</Word>
			<Word>new</Word>
			<Word>using</Word>
			<Word>class</Word>
			<Word>struct</Word>
			<Word>void</Word>
			<Word>function</Word>
			<Word>endfunction</Word>
			<Word>EndFunction</Word>
			<Word>true</Word>
			<Word>True</Word>
			<Word>false</Word>
			<Word>False</Word>
		</Keywords>

		<!-- ─── ACCESS MODIFIERS ─── -->
		<Keywords color="Visibility">
			<Word>local</Word>
			<Word>public</Word>
			<Word>private</Word>
			<Word>protected</Word>
			<Word>static</Word>
			<Word>readonly</Word>
			<Word>const</Word>
			<Word>override</Word>
			<Word>virtual</Word>
			<Word>abstract</Word>
			<Word>sealed</Word>
		</Keywords>

		<!-- ─── NIL / NULL / THIS ─── -->
		<Keywords color="NilKeyword">
			<Word>nil</Word>
			<Word>null</Word>
		</Keywords>

		<Keywords color="SystemDef">
			<Word>this</Word>
			<Word>base</Word>
		</Keywords>

		<!-- ─── SCRIPT SPECIAL TYPES ─── -->
		<Keywords color="ScriptType">
			<Word>var</Word>
			<Word>int</Word>
			<Word>Int</Word>
			<Word>float</Word>
			<Word>Float</Word>
			<Word>double</Word>
			<Word>Double</Word>
			<Word>bool</Word>
			<Word>Bool</Word>
			<Word>string</Word>
			<Word>String</Word>
			<Word>Actor</Word>
			<Word>actor</Word>
			<Word>ActorBase</Word>
			<Word>Armor</Word>
			<Word>Auto</Word>
			<Word>Extends</Word>
			<Word>Faction</Word>
			<Word>faction</Word>
			<Word>FormList</Word>
			<Word>formlist</Word>
			<Word>form</Word>
			<Word>GlobalVariable</Word>
			<Word>globalvariable</Word>
			<Word>Idle</Word>
			<Word>Key</Word>
			<Word>keyword</Word>
			<Word>Keyword</Word>
			<Word>leveleditem</Word>
			<Word>MagicEffect</Word>
			<Word>Message</Word>
			<Word>Outfit</Word>
			<Word>Package</Word>
			<Word>Quest</Word>
			<Word>quest</Word>
			<Word>race</Word>
			<Word>Scene</Word>
			<Word>scene</Word>
			<Word>ScriptName</Word>
			<Word>Sound</Word>
			<Word>Spell</Word>
			<Word>spell</Word>
			<Word>visualeffect</Word>
			<Word>VoiceType</Word>
		</Keywords>

		<!-- ─── SYSTEM OPERATIONS ─── -->
		<Keywords color="SystemOp">
			<Word>Modify</Word>
			<Word>Insert</Word>
			<Word>Delete</Word>
		</Keywords>

		<!-- ─── METHOD CALLS ─── -->
		<Rule color="MethodCall">
			\b[\d\w_]+(?=\s*\()
		</Rule>
		<Rule color="MethodCall">
			\b[\d\w_]+(?=\s*\")
		</Rule>
		<Rule color="MethodCall">
			\b[\d\w_]+(?=\s*\')
		</Rule>
		<Rule color="MethodCall">
			\b[\d\w_]+(?=\s*\{)
		</Rule>

		<!-- ─── NUMBER LITERALS ─── -->
		<Rule color="NumberLiteral">
			\b0[xX][0-9a-fA-F]+
			|
			(\b\d+(\.[0-9]+)?|\.[0-9]+)([eE][+-]?[0-9]+)?
		</Rule>

		<!-- ─── PUNCTUATION ─── -->
		<Rule color="Punctuation">
			[?,.;()\[\]{}+\-/%*&lt;&gt;^+~!|&amp;]+
		</Rule>

	</RuleSet>
</SyntaxDefinition>