<?xml version="1.0"?>
<SyntaxDefinition name="SkyrimBook" extensions=".slua;.lua"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

	<Color name="Tag"     foreground="#FFF7F1BA" />
	<Color name="XMLTag"  foreground="#FFF7F1BA" />
	<Color name="StringDouble" foreground="#FFF7F1BA" />
	
	<Color name="StringSingle" foreground="#CE9178" />

	<RuleSet>

		<Span color="Tag" multiline="false">
			<Begin>\[</Begin>
			<End>\]</End>
		</Span>

		<Span color="XMLTag" multiline="false">
			<Begin>&lt;</Begin>
			<End>&gt;</End>
		</Span>

		<Span color="StringDouble" multiline="false">
			<Begin>"</Begin>
			<End>"</End>
		</Span>
	</RuleSet>
</SyntaxDefinition>