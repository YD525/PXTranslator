<Window x:Class="PhoenixTranslator.ModFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:preview="clr-namespace:PhoenixTranslator.UIManagement.Preview"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhoenixTranslator"
        Style="{DynamicResource DefWin}"
        mc:Ignorable="d"
        Title="ModFileDialog" Height="650" Width="800" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
    <Border Background="#FF282828" CornerRadius="9" BorderThickness="1" BorderBrush="#FFF7F2C0">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseDown="WinHead_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <Label Foreground="White" VerticalAlignment="Center" Margin="5 0 0 0">
                            Mod File Dialog
                        </Label>
                    </StackPanel>

                    <Border Style="{DynamicResource BlockButton}" Grid.Column="7" PreviewMouseDown="Close_PreviewMouseDown" HorizontalAlignment="Right" Margin="0 0 5 0" Cursor="Hand">
                        <ContentControl Style="{DynamicResource CloseIconStyle}" Grid.Column="3"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Margin="5" x:Name="PathBox"  Style="{StaticResource PathBox}" TextChanged="PathBox_TextChanged" Grid.Column="0">
                    </TextBox>
                   
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Margin="5" x:Name="SearchBox"  Style="{StaticResource LSearchTextBox}"  Grid.Column="0">
                    </TextBox>
                </Grid>
                
                <Grid Name="CModView" Grid.Row="3" Margin="5">
                  
                  
                </Grid>

                <StackPanel Name="AvailableFilesView" Grid.Row="3" Margin="5" Visibility="Collapsed">

                    <TextBlock Text="Available Files" Foreground="#FFA8A8A8"  FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <ListBox Height="390" x:Name="AvailableFileList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource for_scrollviewer}"/>
                        </ListBox.Resources>
                        
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">

                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#909090"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Margin" Value="0,2"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#20FFFFFF"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#40FFFFFF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>

                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>


                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Style="{StaticResource ModActionButton}" Content="Load Selected" Width="100" Height="28" Margin="5,0" Click="LoadCurrent_Click"/>
                        <!--<Button Style="{StaticResource ModActionButton}" Content="Load All" Width="100" Height="28" Margin="5,0" Click="LoadAll_Click"/>-->
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
